# Local LM Studio (default) — liefert logprobs
LLM_PROVIDER=lmstudio
LLM_MODEL=lfm2-1.2b-rag
LLM_PROVIDER_URL=http://localhost:1234/v1

# Darf das Modell vor der Antwort nachdenken? (nur lmstudio/vllm)
# false = reasoning_effort "none" — für ein Ein-Wort-Label nur Overhead:
#         Reasoning-Modelle verbrauchen sonst das Token-Budget beim Denken
#         und liefern am Ende gar keine Kategorie.
# true  = Reasoning an, dann MAX_OUTPUT_TOKENS in src/classify.ts beachten.
LLM_REASONING=false

# Local vLLM — liefert logprobs
# LLM_PROVIDER=vllm
# LLM_MODEL=Qwen/Qwen3-8B
# LLM_PROVIDER_URL=http://localhost:8000/v1
# RUNPOD_API_KEY=your-api-key

# Local Ollama — keine logprobs
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_PROVIDER_URL=http://localhost:11434

# Vercel AI Gateway (https://vercel.com/ai-gateway)
# LLM_PROVIDER=gateway
# LLM_MODEL=alibaba/qwen-3-14b
# AI_GATEWAY_API_KEY=your-api-key
